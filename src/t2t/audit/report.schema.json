{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditReport",
  "type": "object",
  "required": [
    "timestamp",
    "version",
    "device_list",
    "config_hashes",
    "findings",
    "summary"
  ],
  "properties": {
    "timestamp": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "device_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "severity",
          "device",
          "message",
          "remediation",
          "exam_topic"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          },
          "device": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "exam_topic": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total_devices",
        "high_count",
        "medium_count",
        "low_count",
        "passed"
      ],
      "properties": {
        "total_devices": {
          "type": "integer",
          "minimum": 0
        },
        "high_count": {
          "type": "integer",
          "minimum": 0
        },
        "medium_count": {
          "type": "integer",
          "minimum": 0
        },
        "low_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "boolean"
        }
      }
    }
  }
}
